local EspGui = inst("ScreenGui",{Name="OMNI_ESP",ResetOnSpawn=false,IgnoreGuiInset=true},CoreGui)
local EspObjs = {}

local function createEsp(p)
    if EspObjs[p] then EspObjs[p].destroy() end
    local c = inst("Frame",{Size=UDim2.new(0,0,0,0),BackgroundTransparency=1,Visible=false},EspGui)
    local box = inst("Frame",{Size=UDim2.new(0,0,0,0),BackgroundTransparency=1},c)
    stroke(1,Color3.new(1,0,0),box)
    local name = inst("TextLabel",{Size=UDim2.new(0,100,0,20),BackgroundTransparency=1,TextColor3=Color3.new(1,1,1),TextSize=12,Font=T.FONT,TextStrokeTransparency=0},c)
    local tracer = inst("Frame",{Size=UDim2.new(0,1,0,0),BackgroundColor3=Color3.new(1,0,0),BorderSizePixel=0},EspGui)
    
    EspObjs[p] = {
        container = c, box = box, name = name, tracer = tracer,
        destroy = function() c:Destroy(); tracer:Destroy() end
    }
end

local function updateEsp(p)
    local o = EspObjs[p]
    if not o or not S.espEnabled or not p.Character then 
        if o then o.container.Visible = false; o.tracer.Visible = false end
        return 
    end
    
    local head = p.Character:FindFirstChild("Head")
    if not head then return end
    
    local pos, on = Camera:WorldToViewportPoint(head.Position)
    if not on then o.container.Visible=false; o.tracer.Visible=false; return end
    
    o.container.Visible = true
    o.name.Text = p.Name
    o.name.Position = UDim2.new(0,pos.X-50,0,pos.Y-30)
    
    -- Skeleton / Tracer
    o.tracer.Visible = true
    o.tracer.Position = UDim2.new(0, Camera.ViewportSize.X/2, 0, Camera.ViewportSize.Y)
    local dist = (Vector2.new(pos.X,pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)).Magnitude
    local angle = math.atan2(pos.Y - Camera.ViewportSize.Y, pos.X - Camera.ViewportSize.X/2)
    o.tracer.Size = UDim2.new(0,1,0,dist)
    o.tracer.Rotation = math.deg(angle) + 90
    
    -- Box
    o.box.Visible = true
    o.box.Size = UDim2.new(0, 50, 0, 100)
    o.box.Position = UDim2.new(0, pos.X-25, 0, pos.Y-50)
end

