        TextWrapped          = true,
    }, acceptPanel)

    -- ── FREEZE PANEL EXTRAS: info text ───────────────────────
    local freezePanel = panels["freeze"].panel

    inst("TextLabel", {
        Size                 = UDim2.new(1,-16,0,46),
        Position             = UDim2.new(0,8,0,34),
        BackgroundTransparency = 1,
        Text                 = "Hooks the cancel/decline remote so any\nfire of it during an active trade is\nsilently swallowed. Partner can't back out.",
        TextColor3           = T.TEXT_DIM, TextSize = 10,
        Font                 = T.FONT, ZIndex = 4,
        TextXAlignment       = Enum.TextXAlignment.Left,
        TextWrapped          = true,
    }, freezePanel)

    -- ── REMOTE SCAN LOG (bottom strip) ───────────────────────
    local logPanel = inst("Frame", {
        Size             = UDim2.new(1,-12, 0, 24),
        Position         = UDim2.new(0,6,1,-30),
        BackgroundColor3 = T.PANEL,
        BorderSizePixel  = 0, ZIndex = 3,
    }, content)
    corner(4, logPanel)

    local logLbl = inst("TextLabel", {
        Size                 = UDim2.new(1,-8,1,0),
        Position             = UDim2.new(0,6,0,0),
        BackgroundTransparency = 1,
        Text                 = "scanning remotes...",
        TextColor3           = T.TEXT_DIM, TextSize = 10,
        Font                 = T.FONT, ZIndex = 4,
        TextXAlignment       = Enum.TextXAlignment.Left,
    }, logPanel)

    -- ── LIVE STATUS UPDATER ───────────────────────────────────
    RunService.Heartbeat:Connect(function()
        -- Main status bar
        local tradeStr = S.inTrade
            and ("IN TRADE  |  Partner: " .. S.partnerName .. (S.countdownActive and "  |  ⚠ COUNTDOWN" or ""))
            or  "no active trade"
        statusLbl.Text      = tradeStr
        statusLbl.TextColor3 = S.inTrade and T.GREEN or T.TEXT_DIM

        -- Per-panel status
        panels["scam"].status.Text   = "status: " .. S.statusScam
        panels["accept"].status.Text = "status: " .. S.statusAccept
        panels["freeze"].status.Text = "status: " .. S.statusFreeze

        -- Remote log
        local found = 0
        for _ in pairs(S.remotes) do found = found + 1 end
        logLbl.Text = string.format(
            "remotes found: %d / %d   |   items tracked: %d   |   trash: %d",
            found, 6, #S.ourItems, #S.trashItems
        )
        logLbl.TextColor3 = found >= 3 and T.GREEN or T.YELLOW
    end)

    return win
end

